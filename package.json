{
  "name": "swg-legends-localstack-infra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SWG Legends crafting & resource intelligence — local AWS infrastructure learning project",
  "scripts": {
    "build": "tsc",
    "verify": "tsx src/verify-localstack.ts",
    "localstack:up": "docker compose up -d",
    "localstack:down": "docker compose down",
    "localstack:status": "curl -s http://localhost:4566/_localstack/health | python3 -m json.tool",
    "localstack:logs": "docker logs -f localstack",
    "localstack:reset": "docker compose down -v && docker compose up -d",
    "aws:s3:ls": "aws --profile localstack s3 ls",
    "aws:dynamo:tables": "aws --profile localstack dynamodb list-tables",
    "tofu:init:storage": "tofu -chdir=tofu/storage init",
    "tofu:plan:storage": "tofu -chdir=tofu/storage plan",
    "tofu:apply:storage": "tofu -chdir=tofu/storage apply -auto-approve",
    "tofu:destroy:storage": "tofu -chdir=tofu/storage destroy -auto-approve",
    "ingest": "tsx src/ingest/pipeline.ts",
    "diff": "tsx src/ingest/diff.ts",
    "query": "tsx src/query/find-resources.ts",
    "events": "tsx src/query/event-log.ts",
    "process:history": "tsx src/messaging/process-history.ts",
    "process:alerts": "tsx src/messaging/process-alerts.ts",
    "alerts:add": "tsx src/alerts/add-rule.ts",
    "alerts:list": "tsx src/alerts/list-rules.ts",
    "alerts:remove": "tsx src/alerts/remove-rule.ts",
    "alerts:history": "tsx src/alerts/history.ts",
    "lambda:build": "tsx scripts/build-lambdas.ts",
    "dashboard": "tsx src/export/generate-dashboard.ts",
    "tofu:init:messaging": "tofu -chdir=tofu/messaging init",
    "tofu:plan:messaging": "tofu -chdir=tofu/messaging plan",
    "tofu:apply:messaging": "tofu -chdir=tofu/messaging apply -auto-approve",
    "tofu:destroy:messaging": "tofu -chdir=tofu/messaging destroy -auto-approve",
    "tofu:init:compute": "tofu -chdir=tofu/compute init",
    "tofu:plan:compute": "tofu -chdir=tofu/compute plan",
    "tofu:apply:compute": "tofu -chdir=tofu/compute apply -auto-approve",
    "tofu:destroy:compute": "tofu -chdir=tofu/compute destroy -auto-approve",
    "tofu:init:api": "tofu -chdir=tofu/api init",
    "tofu:plan:api": "tofu -chdir=tofu/api plan",
    "tofu:apply:api": "tofu -chdir=tofu/api apply -auto-approve",
    "tofu:destroy:api": "tofu -chdir=tofu/api destroy -auto-approve",
    "api:test": "tsx src/api/test-api.ts",
    "tofu:init:orchestration": "tofu -chdir=tofu/orchestration init",
    "tofu:plan:orchestration": "tofu -chdir=tofu/orchestration plan",
    "tofu:apply:orchestration": "tofu -chdir=tofu/orchestration apply -auto-approve",
    "tofu:destroy:orchestration": "tofu -chdir=tofu/orchestration destroy -auto-approve",
    "pipeline:start": "tsx src/pipeline/start.ts",
    "pipeline:status": "tsx src/pipeline/status.ts",
    "tofu:init:monitoring": "tofu -chdir=tofu/monitoring init",
    "tofu:plan:monitoring": "tofu -chdir=tofu/monitoring plan",
    "tofu:apply:monitoring": "tofu -chdir=tofu/monitoring apply -auto-approve",
    "tofu:destroy:monitoring": "tofu -chdir=tofu/monitoring destroy -auto-approve",
    "dashboard:ops": "tsx src/export/generate-ops-dashboard.ts",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:deploy": "tsx scripts/deploy-frontend.ts",
    "scrape:tree": "tsx scripts/scrape-resource-tree.ts",
    "tofu:init:classification": "tofu -chdir=tofu/classification init",
    "tofu:plan:classification": "tofu -chdir=tofu/classification plan",
    "tofu:apply:classification": "tofu -chdir=tofu/classification apply -auto-approve",
    "tofu:destroy:classification": "tofu -chdir=tofu/classification destroy -auto-approve",
    "seed:classes": "tsx scripts/seed-resource-classes.ts",
    "backfill:classes": "tsx scripts/backfill-resource-classes.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.1124.0",
    "@aws-sdk/client-cloudwatch-events": "^3.1121.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1124.0",
    "@aws-sdk/client-dynamodb": "^3.0.0",
    "@aws-sdk/client-lambda": "^3.1121.0",
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/client-sfn": "^3.1121.0",
    "@aws-sdk/client-sns": "^3.1121.0",
    "@aws-sdk/client-sqs": "^3.1121.0",
    "@aws-sdk/lib-dynamodb": "^3.0.0",
    "fast-xml-parser": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
