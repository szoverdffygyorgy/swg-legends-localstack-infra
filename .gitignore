# Dependencies
node_modules/

# TypeScript build output
dist/

# Frontend build output
frontend/dist/

# OpenTofu / Terraform
.terraform/
*.tfstate
*.tfstate.backup
*.tfvars
!*.tfvars.example
# Note: .terraform.lock.hcl is intentionally NOT ignored.
# It pins provider versions for reproducibility (like package-lock.json).

# Environment and secrets
.env
.env.*
!.env.example

# Downloaded data (large XML/gzip exports from SWGAide)
data/

# Static reference data in src/data/ should be tracked
!src/data/

# Corporate proxy CA certificates (machine-specific)
certs/

# OS junk
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Logs
*.log
